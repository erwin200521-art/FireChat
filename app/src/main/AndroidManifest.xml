<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FireChatApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_chat"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FireChat"
        tools:targetApi="34">

        <!-- Pantalla inicial: si hay sesión activa redirige a UsersActivity -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.users.UsersActivity"
            android:exported="false" />

        <!-- parentActivityName permite construir la pila de retroceso al abrir desde una notificación -->
        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:parentActivityName=".ui.users.UsersActivity"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".notifications.FireChatMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_id" />
    </application>
</manifest>
